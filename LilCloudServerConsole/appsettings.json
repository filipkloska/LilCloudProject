{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://127.0.0.1:50421",
        "Protocols": "Http2"
      }
    }
  },
  "Jwt": {
    "Key": "secret_key_change_when_published",
    "Issuer": "LilCloudServer",
    "Audience": "LilCloudClients"
  },
  "HostData": {
    "GrpcPort": 50000,
    "TcpPort": 50001,
    "CpuLimit": 100
  }
}
